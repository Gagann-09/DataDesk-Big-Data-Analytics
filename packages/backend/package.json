    "test:watch": "vitest"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "express": "5.3.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
