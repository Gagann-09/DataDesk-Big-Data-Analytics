{
  "name": "@datadesk/backend",
  "version": "1.0.0",
  "private": true,
  "description": "DataDesk Phase 1 — minimal CSV/JSONL dataset ingestion backend (Express 5, TypeScript, MongoDB driver, WebHDFS storage).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
