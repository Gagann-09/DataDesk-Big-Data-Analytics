# DataDesk backend — Phase 1 dataset ingestion (local teaching lab only).
# Copy this file to `.env` and set local values. NEVER commit `.env` or real secrets.
# .env is gitignored.

NODE_ENV=development
PORT=3456
HOST=127.0.0.1

# MongoDB Community Server 7 (official MongoDB Node.js driver)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=datadesk

# Upload limits (bytes). MAX_UPLOAD_BYTES is the configurable size limit.
MAX_UPLOAD_BYTES=104857600
MAX_VALIDATION_ERRORS=50

# HDFS via WebHDFS (verified approach, memory.md §8e).
# Requires fs.defaultFS / HTTP bind addresses / dfs.webhdfs.enabled=true on the
# NameNode and ?user.name=<write-capable user> (e.g. hadoop) for writes.
WEBHDFS_BASE=http://127.0.0.1:50070/webhdfs/v1
WEBHDFS_USER=hadoop
DATADESK_HDFS_PREFIX=/datadesk
